# ============================================================
# Space Card Shop - Production Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.production .env
#   2. Fill in ALL values below
#   3. NEVER commit .env to git!
# ============================================================

# ==================== Your Domain ====================
FRONTEND_URL=https://YOUR_DOMAIN.com

# ==================== MySQL Database ====================
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_2024
MYSQL_DATABASE=space_card_shop
MYSQL_USER=cardshop
MYSQL_PASSWORD=CHANGE_ME_db_password_2024

# MySQL external port (bound to 127.0.0.1 only, for local admin access)
MYSQL_EXTERNAL_PORT=127.0.0.1:3307

# ==================== JWT Authentication ====================
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_string_here
JWT_EXPIRES_IN=7d

# ==================== Node.js ====================
NODE_ENV=production
PORT=3000
