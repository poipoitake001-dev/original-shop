# ========================================
# 后端环境变量配置示例
# 复制此文件为 .env 并填写实际配置
# ========================================

# 服务器端口
PORT=3000

# ========== 方式一：本地开发（单独配置）==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=space_card_shop

# ========== 方式二：云数据库（连接字符串）==========
# 如果设置了 DATABASE_URL，将忽略上面的单独配置
# PlanetScale 示例：
# DATABASE_URL=mysql://username:password@host/database?ssl={"rejectUnauthorized":true}
# Railway MySQL 示例：
# DATABASE_URL=mysql://root:password@host:port/railway

# ========== Prisma 数据库连接（必须设置）==========
# Prisma 使用 DATABASE_URL 连接数据库
# 本地开发示例：
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/space_card_shop"

# JWT 密钥（用于用户认证，请使用复杂的随机字符串）
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_random

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 允许的前端域名（CORS，生产环境设置）
# FRONTEND_URL=https://your-app.vercel.app
