# ========================================
# HeidiSQL 文件 - 不需要上传
# ========================================

*.dll
*.exe
*.ini
*.txt
plugins/
Snippets/
portable.lock
portable_settings.txt
gpl.txt
license.txt
LICENSE-openssl

# ========================================
# 敏感文件 - 绝不上传
# ========================================

# 环境变量文件（包含数据库密码、密钥等）
.env
.env.local
backend/.env
frontend/.env

# .env.production is a TEMPLATE (no real secrets) — keep it in git
# !.env.production

